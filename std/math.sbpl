include "prelude.sbpl"
include "stdio.sbpl"

define MATH_TAYLOR_SERIES_MAX_TERM 20
define MATH_HERON_TERMS 20

define PI 3.14159265358979323846
define PI_2 1.5707963267948966
define _2_PI 6.283185307179586
define LN_2 0.6931471805599453
define E 2.718281828459045

define PIO2_1 1.5707963267948966
define PIO2_2 6.1232339957367660e-17
define PIO2_3 2.0222662487959506e-21

define INV_PIO2 0.63661977236758134308

func roundtoi64 float64 : int64 in
    let x

    if x 0.0 >= then x 0.5 + int64 return end
    x 0.5 - int64
end

func iswhole float64 : int64 in
    let x
    x x int64 float64 = 
end

func signi64 int64 : int64 in 
    let x
    0

    if x 0 < then
        drop -1

    else if x 0 > then
        drop 1

    end end
end

func signf64 float64 : int64 in 
    let x
    0

    if x 0.0 < then
        drop -1

    else if x 0.0 > then
        drop 1

    end end
end

func moduf64 float64 float64 : float64 in
    let a b 
    a int64 b int64 / float64
    b *
    a swap -
end

func floor float64 : int64 in
    let x
    if x 0.0 < x iswhole ! && then
        x int64 1 - return
    end

    x int64
end

func ceil float64 : int64 in
    let x
    if x 0.0 < x iswhole || then
        x int64 return
    end

    x int64 1 +
end

func powfui float64 int64 : float64 in 
    let base exponent

    1.0 0 while dup exponent < do
        swap base * swap
        1 +
    end drop
end

func powiui int64 int64 : int64 in 
    let base exponent

    1 0 while dup exponent < do
        swap base * swap
        1 +
    end drop
end

func rad_to_deg float64 : float64 in
    180.0 * PI /
end

func deg_to_rad float64 : float64 in
    PI 180.0 / *
end

func factorial int64 : int64 in
    let n

    1 2 while dup n <= do
        dup reach * swap
        1 +
    end drop
end

func ncr int64 int64 : int64 in 
    let r n 

    if n 0 < r 0 < || then "error: ncr only takes positive numbers as arguments" eputs 1 exit end

    n factorial 
    r factorial n r - factorial * /
end

func __kernel_cos__ float64 : float64 in
    let x

    4.16666666666666019037e-02 let C1
    -1.38888888888741095749e-03 let C2
    2.48015872894767294178e-05 let C3
    -2.75573143513906633035e-07 let C4
    2.08757232129817482790e-09 let C5
    -1.13596475577881948265e-11 let C6

    x x * let z
    z z * let z2

    z C6 * C5 + z * C4 + z * C3 + z * C2 + z * C1 + let poly
    1.0 0.5 z * - poly z2 * +  
end

func __kernel_sin__ float64 : float64 in
    let x

    -1.66666666666666324348e-01 let S1
    8.33333333332248946124e-03 let S2
    -1.98412698298579493134e-04 let S3
    2.75573137070700676789e-06 let S4
    -2.50507602534068634195e-08 let S5
    1.58969099521155010221e-10 let S6
 
    x x * let z 
    z x * let v
    z S6 * S5 + z * S4 + z * S3 + z * S2 + let poly
    z poly * S1 + v * x + 
end

; (k mod 4, remainder)
func __rempio2_quadrant__ float64 : int64 float64 in
    let x 
    
    x INV_PIO2 * roundtoi64 float64 let k

    x k PIO2_1 * - k PIO2_2 * - k PIO2_3 * - let r 

    r k int64 3 &
end

; (sin(x), cos(x))
func __sincos_approx__ float64 : float64 float64 in
    let x
    x __rempio2_quadrant__ let r q

    r __kernel_sin__ let s
    r __kernel_cos__ let c

    if q 0 = then s c return end
    if q 1 = then c s negf64 return end
    if q 2 = then s negf64 c negf64 return end
    if q 3 = then c negf64 s return end
    
    0.0 0.0
end

func sin float64 : float64 in
    __sincos_approx__ drop
end

func cos float64 : float64 in
    __sincos_approx__ swap drop
end

func tan float64 : float64 in
    PI moduf64
    let x
    x sin x cos /
end

func sec float64 : float64 in
    let x
    1.0 x cos /
end

func csc float64 : float64 in
    let x
    1.0 x sin /
end

func cot float64 : float64 in
    let x
    1.0 x tan /
end

; Rational fitting
func __atan_approx_domain_limited__ float64 : float64 in
    let x
    1.0 0.43157974 x x * * +
    1.0 0.76443945 x x * * + 0.05831938 x 4 powfui * +
    /
    x *
end

func atan float64 : float64 in
    let x 

    if x 1.0 > then
        PI_2 1.0 x / __atan_approx_domain_limited__ -

    else if x -1.0 < then
        PI_2 negf64 1.0 x / __atan_approx_domain_limited__ -

    else 
        x __atan_approx_domain_limited__
    end end
end

func asin float64 : float64 in
    let x
    
    if x absf64 1.0 > then
        "error: the domain of asin is [-1, 1]" eputs
        1 exit
    end

    x 1.0 x x * - sqrt / 
    atan 
end

func acos float64 : float64 in
    let x

    if x absf64 1.0 > then
        "error: the domain of acos is [-1, 1]" eputs
        1 exit
    end

    PI_2 x asin -
end

func asec float64 : float64 in
    let x
    1.0 x / acos
end

func acsc float64 : float64 in
    let x
    1.0 x / asin
end

func acot float64 : float64 in
    let x

    PI 2.0 /

    if x 0.0 > then
        drop 1.0 x / atan
    end

    if x 0.0 < then
        drop 1.0 x / atan PI +
    end
end

func __exp_taylor__ float64 int64 : float64 in
    let x terms

    1.0 x +
    2 while dup terms <= do
        let ind
        x ind powfui ind factorial float64 / +

        ind 1 +
    end drop
end

func exp float64 : float64 in 
    dup 0.0 < let is_negative
    absf64 let x

    x floor let a
    x a float64 - let b

    E a powfui 
    b MATH_TAYLOR_SERIES_MAX_TERM __exp_taylor__ 
    *

    if is_negative then 1.0 swap / end 
end

func __artanh_taylor__ float64 int64 : float64 in 
    let x terms

    0.0 
    0 while dup terms < do
        let ind

        ind 2 * 1 + let common_odd

        x common_odd powfui 
        common_odd float64 
        / +

        ind 1 +
    end drop
end

func ln float64 : float64 in
    let x

    0 let a
    x let b

    while b 2.0 > do
        b 2.0 / let b
        a 1 + let a
    end

    while b 0.5 < do
        b 2.0 * let b
        a 1 - let a
    end

    b 1.0 - b 1.0 + / 
    MATH_TAYLOR_SERIES_MAX_TERM __artanh_taylor__ 
    2.0 * let ln_b

    a float64 LN_2 * ln_b +
end

; x b log -> log_b(x)
func log float64 float64 : float64 in
    ln swap ln swap /
end

func log2 float64 : float64 in
    2.0 log
end

func log10 float64 : float64 in
    10.0 log
end

func powff float64 float64 : float64 in
    let base exponent

    if base 0.0 <= then
        if exponent iswhole then
            base exponent int64 powfui return

        else
            "error: powff cannot compute negative to the non-whole power" eputs
            1 exit
        end
    
    end

    exponent base ln * exp
end

func sqrt float64 : float64 in
    let s

    if s 0.0 < then
        "error: cannot compute sqrt of negative number" eputs
        1 exit
    end

    s 2.0 / let x_n

    0 while dup MATH_HERON_TERMS < do
        x_n s x_n / + 0.5 * let x_n
        1 +
    end drop 
    
    x_n
end

func cbrt float64 : float64 in 0.333333 powff end

func cosh float64 : float64 in 
    let x
    x exp x negf64 exp + 2.0 /
end

func sinh float64 : float64 in 
    let x
    x exp x negf64 exp - 2.0 /
end

func tanh float64 : float64 in 
    let x
    x sinh x cosh /
end

func sech float64 : float64 in 1.0 swap cosh / end
func csch float64 : float64 in 1.0 swap sinh / end
func coth float64 : float64 in 1.0 swap tanh / end
