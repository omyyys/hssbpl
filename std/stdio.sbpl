include "string.sbpl"
include "linux.sbpl"

define STDIN  0 
define STDOUT 1
define STDERR 2

define AT_FDCWD -100
define O_RDONLY  0
define O_WRONLY  1
define O_RDWR    2 

define O_CREAT  64 
define O_TRUNC  512 
define O_APPEND 1024

func negi64 int64 : int64 in
    0 swap -
end

func negf64 float64 : float64 in
    0.0 swap -
end

func absi64 int64 : int64 in 
    let x

    if x 0 < then 
        x negi64 return
    end 

    x
end

func absf64 float64 : float64 in 
    let x

    if x 0.0 < then 
        x negf64 return
    end

    x
end

func fprints int64 string : in 
    dup strlen sys_write drop 
end

func prints string : in
    STDOUT swap fprints
end

func eprints string : in
    STDERR swap fprints
end

func fputs int64 string : in
    let fd str
    fd str fprints 
    fd "\n" fprints
end

func puts string : in
    STDOUT swap fputs
end

func eputs string : in
    STDERR swap fputs
end

func putc int64 char : in
    let fd c
    declare putc_buf char 1

    putc_buf c !!
    fd putc_buf 1 sys_write drop
end

func putchar char : in
    STDOUT swap putc
end

func fread int64 ptr@char int64 : int64 in sys_read end

func drain_stdin_line : in
    var drain char
    drain '\0' !!

    while drain ?? '\n' != do
        STDIN drain 1 fread drop
    end
end

; removes newline
func fgets int64 ptr@char int64 : int64 in fread end

func gets ptr@char int64 : in
    let buf count
    STDIN buf count fgets let chars_read
    buf chars_read 1 - '\0' char$$
    if chars_read count > then drain_stdin_line end
end

func getc int64 : char in
    let fd
    var getc_result char

    fd getc_result 1 fread drop
    getc_result ??
    drain_stdin_line
end

func getchar : char in
    STDIN getc
end

; No newline
func printi64 int64 : in
    declare print_buf char 25
    print_buf itos10
    print_buf prints
end

func puti64 int64 : in
    let x 

    if x 0 < then
        "-" prints
        x absi64 print
    else 
        x print
    end
end

func __print_padded_int64__ int64 int64 : in
    let v width 

    1 1 let pow_10 i
    while i width < do
        pow_10 10 * let pow_10
        i 1 + let i
    end

    while pow_10 0 > do
        v pow_10 / 10 % let digit
        '0' digit + putchar
        pow_10 10 / let pow_10
    end
end

func printuf64 float64 : in
    let x
    10000000000 let scale 

    x scale float64 * 0.5 + int64 let scaled 
    scaled scale / let whole_part
    scaled scale % let frac_part

    whole_part printi64
    "." prints 
    frac_part 10 __print_padded_int64__
end

func printf64 float64 : in
    let x

    if x 0.0 < then
        "-" prints
        x absf64 printuf64
    else 
        x printuf64
    end 
end

func putf64 float64 : in
    printf64 '\n' putchar 
end

func putptr ptr@any : in
    int64 let as_int
    declare hex_buf char 17 ; max 16 hex digits in 64 bit + null terminator byte
    as_int hex_buf 16 itos
    "0x" prints hex_buf puts
end

func fopenr string : int64 in
    AT_FDCWD swap O_RDONLY 0 sys_openat
end

func fopenw string : int64 in
    O_WRONLY O_CREAT | O_TRUNC | let flags
    AT_FDCWD swap flags 438 sys_openat
end
