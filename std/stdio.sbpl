include "string.sbpl"
include "linux.sbpl"

define STDIN  0 
define STDOUT 1
define STDERR 2

define AT_FDCWD -100
define O_RDONLY  0
define O_WRONLY  1
define O_RDWR    2 

define O_CREAT  64 
define O_TRUNC  512 
define O_APPEND 1024

func negi64 int64 : int64 in
    0 swap -
end

func negf64 float64 : float64 in
    0.0 swap -
end

func absi64 int64 : int64 in 
    let x

    if x 0 < then 
        x negi64
    else 
        x
    end
end

func absf64 float64 : float64 in 
    let x

    if x 0.0 < then 
        x negf64
    else 
        x
    end
end

func sys_write int64 ptr int64 : int64 in
    let fd buf count
    SYS_WRITE fd buf count __syscall3__
end

func fprints int64 ptr : in 
    dup strlen sys_write drop 
end

func prints ptr : in
    STDOUT swap fprints
end

func eprints ptr : in
    STDERR swap fprints
end

func fputs int64 ptr : in
    let fd str
    fd str fprints 
    fd "\n" fprints
end

func puts ptr : in
    STDOUT swap fputs
end

func eputs ptr : in
    STDERR swap fputs
end

func fread int64 ptr int64 : int64 in
    let fd buf count
    SYS_READ fd buf count __syscall3__ 
end

func gets int64 ptr : in
    STDIN swap reach fread drop
end

func puti64 int64 : in
    let x 

    if x 0 < then
        "-" prints
        x absi64 print
    else 
        x print
    end
end

func putuf64 float64 : in
    let x
    x int64 let whole_part
    x whole_part float64 - let frac_part

    frac_part 10000000.0 * int64 let decimals_as_int

    whole_part print 
    "." prints 
    decimals_as_int print
end

func putf64 float64 : in
    let x 

    if x 0.0 < then
        "-" prints
        x absf64 putuf64
    else 
        x putuf64
    end
end

func sys_openat int64 ptr int64 int64 : int64 in
    let dfd filename flags mode 
    SYS_OPENAT dfd filename flags mode __syscall4__ 
end

func fopenr ptr : int64 in
    AT_FDCWD swap O_RDONLY 0 sys_openat
end

func fopenw ptr : int64 in
    O_WRONLY O_CREAT | O_TRUNC | let flags
    AT_FDCWD swap flags 438 sys_openat
end
