include "string.sbpl"
include "linux.sbpl"

define STDIN  0 
define STDOUT 1
define STDERR 2

define AT_FDCWD -100
define O_RDONLY  0
define O_WRONLY  1
define O_RDWR    2 

define O_CREAT  64 
define O_TRUNC  512 
define O_APPEND 1024

func negi64 int64 : int64 in
    0 swap -
end

func negf64 float64 : float64 in
    0.0 swap -
end

func absi64 int64 : int64 in 
    let x

    if x 0 < then 
        x negi64 return
    end 

    x
end

func absf64 float64 : float64 in 
    let x

    if x 0.0 < then 
        x negf64 return
    end

    x
end

func fprints int64 string : in 
    dup strlen sys_write drop 
end

func prints string : in
    STDOUT swap fprints
end

func eprints string : in
    STDERR swap fprints
end

func fputs int64 string : in
    let fd str
    fd str fprints 
    fd "\n" fprints
end

func puts string : in
    STDOUT swap fputs
end

func eputs string : in
    STDERR swap fputs
end

func putc int64 char : in
    let fd c
    declare putc_buf char 1

    putc_buf c !!
    fd putc_buf 1 sys_write drop
end

func putchar char : in
    STDOUT swap putc
end

func fread int64 ptr@char int64 : int64 in sys_read end

func gets int64 ptr@char : in
    STDIN swap reach fread drop
end

func getc int64 : char in
    let fd
    declare getc_buf char 1

    fd getc_buf 1 sys_read drop
    getc_buf ??
end

func getchar : char in
    STDOUT getc
end

func puti64 int64 : in
    let x 

    if x 0 < then
        "-" prints
        x absi64 print
    else 
        x print
    end
end

func putuf64 float64 : in
    let x
    declare whole_part_buf char 10 

    x int64 let whole_part
    x whole_part float64 - let frac_part

    frac_part 10000000.0 * int64 let decimals_as_int
    
    whole_part whole_part_buf itos10
    whole_part_buf prints
    "." prints 
    decimals_as_int print
end

func putf64 float64 : in
    let x 

    if x 0.0 < then
        "-" prints
        x absf64 putuf64
    else 
        x putuf64
    end
end

func putptr ptr@any : in
    int64 let as_int
    declare hex_buf char 17 ; max 16 hex digits in 64 bit + null terminator byte
    as_int hex_buf 16 itos
    "0x" prints hex_buf puts
end

func fopenr string : int64 in
    AT_FDCWD swap O_RDONLY 0 sys_openat
end

func fopenw string : int64 in
    O_WRONLY O_CREAT | O_TRUNC | let flags
    AT_FDCWD swap flags 438 sys_openat
end
