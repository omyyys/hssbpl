include "linux.sbpl"

define bool int64
define true 1
define false 0

define NULL 0 ptr

func char?? ptr int64 : char in 
    + char*
end

func char$$ ptr int64 char : in 
    let c 
    +
    c char&
end

func int64?? ptr int64 : int64 in
    8 * + int64*
end

func int64$$ ptr int64 int64 : in 
    let i 
    8 * +
    i int64&
end

func ptr?? ptr int64 : int64 in
    8 * + int64*
end

func ptr$$ ptr int64 ptr : in 
    let p 
    8 * +
    p ptr&
end

func float64?? ptr int64 : float64 in
    8 * + float64*
end

func float64$$ ptr int64 float64 : in
    let fl 
    8 * +
    fl float64&
end

func isspace? char : bool in
    let c 
    false
    if 32 c = 10 c = || 9 c = || then 
        drop true
    end
end

func isdigit? char : bool in 
    let c
    c 48 >= c 57 <= &&
end

func isupper? char : bool in 
    let c
    c 65 >= c 90 <= &&
end

func islower? char : bool in
    let c
    c 97 >= c 122 <= &&
end

func isalpha? char : bool in 
    let c
    c islower? c isupper? ||
end

func exit int64 : in 
    SYS_EXIT swap __syscall1__ drop
end
