include "prelude.sbpl"
include "math.sbpl"

func memcpy ptr@any ptr@any int64 : in
    let size
    ptr@char let src
    ptr@char let dest

    0 while dup size < do
        let ind
        dest ind src ind char?? char$$ 
        ind 1 +
    end drop
end

func memset ptr@any int64 int64 : in
    let byte size 
    ptr@char let dest

    0 while dup size < do
        let ind
        dest ind byte char char$$
        ind 1 +
    end drop
end

func strlen string : int64 in
    let str

    0 while dup str swap char?? 0 != do
        1 +
    end
end

func stoi string : int64 in 
    let s

    s strlen let s_len
    0 let is_neg
    0 let stoi_error

    if s 0 char?? '-' = then
        1 let is_neg 
        s 1 + let s
        s_len 1 - let s_len
    end

    0 0 while dup s_len < do 
        let ind

        s ind char?? let c

        if c isdigit? ! then  
            s_len 1 + let ind
            1 let stoi_error
        end

        c int64 '0' int64 -
        10 s_len ind 1 + - powiui * +

        ind 1 +

    end drop

    if is_neg then negi64 end
    if stoi_error then drop 0 end
end
