include "prelude.sbpl"
include "math.sbpl"

func memcpy ptr@any ptr@any int64 : in
    let count
    ptr@char let src
    ptr@char let dest

    0 while dup count < do
        let ind
        dest ind src ind char?? char$$ 
        ind 1 +
    end drop
end

func memmove ptr@any ptr@any int64 : in
let count
    ptr@char let src
    ptr@char let dest
    0 let ind
    
    if dest src < dest src count + >= || then
        while ind count < do
            dest ind src ind char?? char$$
            ind 1 + let ind
        end
    else
        while count 0 != do
            count 1 - let count
            dest count src count char?? char$$
        end
    end
end

func memset ptr@any int64 int64 : in
    let byte count 
    ptr@char let dest

    0 while dup count < do
        let ind
        dest ind byte char char$$
        ind 1 +
    end drop
end

func memeq? ptr@any ptr@any int64 : bool in
    let count
    ptr@char let m1
    ptr@char let m2

    true
    0 while dup count < do
        let ind
        m1 ind char?? 
        m2 ind char??
        
        if != then 
            drop false
            count let ind
        end

        ind 1 +
    end drop
end

func memchr ptr@any int64 int64 : ptr@any in
    let byte count
    ptr@char let buf

    NULL
    0 while dup count < do
        let ind
        if buf ind char?? byte = then
            drop buf ind + ptr@any
            count let ind
        end

        ind 1 +
    end drop 
end

func memrchr ptr@any int64 int64 : ptr@any in
    let byte count
    ptr@char let buf

    NULL
    0 while dup count < do
        let ind
        if buf ind char?? byte = then
            drop buf ind + ptr@any
        end

        ind 1 +
    end drop 
end

func strlen string : int64 in
    let str

    0 while dup str swap char?? 0 != do
        1 +
    end
end

func strcpy string string : in
    let dest src
    dest src src strlen 1 + memcpy ; also copy null terminator
end

func streq? string string : bool in
    let str1 str2
    
    if str1 strlen str2 strlen != then 
        false
    else
        str1 str2 str1 strlen memeq?
    end
end

func strcat string string : in
    let dest src
    dest dest strlen + let start_cat

    start_cat src strcpy
end

func strchr string char : ptr@char in
    int64 swap dup strlen reach swap
    memchr ptr@char
end

func strrchr string char : ptr@char in
    int64 swap dup strlen reach swap
    memrchr ptr@char
end

func strcontains? string char : bool in
    strchr NULL ptr@char !=
end

func strstr string string : ptr@char in
    let haystack needle 

    haystack let start
    NULL ptr@char let result
    false let result_found

    if needle ?? '\0' = then
        haystack let result
        true let result_found
    end

    while start ?? '\0' != result_found ! && do
        start needle let hs nd

        while hs ?? '\0' != nd ?? '\0' != && hs ?? nd ?? = && do
            hs 1 + nd 1 + let hs nd
        end

        if nd ?? '\0' = then
            start let result
            true let result_found
        end

        if hs ?? '\0' = then
            true let result_found
        end

        start 1 + let start
    end

    result
end

func strsubstr? string string : bool in
    strstr NULL ptr@char !=
end

func strpbrk string string : ptr@char in
    let str accept

    NULL ptr@char let result
    false let result_found

    while str ?? '\0' != result_found ! && do
        if accept str ?? strchr then
            str let result
            true let result_found
        end

        str 1 + let str
    end

    result    
end

func strspn string string : int64 in
    let str accept

    false let break

    str let p
    while p ?? '\0' != break ! && do
        if accept p ?? strcontains? ! then
            true let break
        else
            p 1 + let p
        end
    end

    p str -
end

func strcspn string string : int64 in
    let str reject

    false let break

    str let p
    while p ?? '\0' != break ! && do
        if reject p ?? strcontains? then
            true let break
        else
            p 1 + let p
        end
    end

    p str -
end

func strrev string : in 
    let str
    0 let start
    str strlen 1 - let _end

    while start _end < do 
        str start char?? let temp
        str start str _end char?? char$$
        str _end temp char$$
        _end 1 - let _end
        start 1 + let start
    end
end

func stoi string : int64 in
    let s
    1 0 0 let sign res i

    while s i char?? ' ' = do
        i 1 + let i
    end

    if s i char?? dup '-' = swap '+' = || then
        if s i char?? '-' = then 
            -1 let sign
        end
        i 1 + let i
    end

    while s i char?? dup '0' >= swap '9' <= && do
        s i char?? '0' - int64
        10 res * + let res
        i 1 + let i
    end

    res sign *
end

func itos int64 ptr@char int64 : in 
    let num buf base
    0 let i
    false let is_negative

    if num 0 = then
        buf 0 '0'  char$$
        buf 1 '\0' char$$
    else 
        if num 0 < base 10 = && then
            true let is_negative
            num negi64 let num
        end

        while num 0 != do
            num base % let rem 
            if rem 9 > then
                buf i rem 10 - 'a' + char$$
            else
                buf i rem '0' + char$$
            end

            num base / let num
            i 1 + let i
        end

        if is_negative then
            buf i '-' char$$
            i 1 + let i
        end

        buf i '\0' char$$
        buf strrev
    end
end

func itos10 int64 ptr@char : in
    10 itos
end
