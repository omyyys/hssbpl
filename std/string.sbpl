include "prelude.sbpl"
include "math.sbpl"

func memcpy ptr@any ptr@any int64 : in
    let size
    ptr@char let src
    ptr@char let dest

    0 while dup size < do
        let ind
        dest ind src ind char?? char$$ 
        ind 1 +
    end drop
end

func memset ptr@any int64 int64 : in
    let byte size 
    ptr@char let dest

    0 while dup size < do
        let ind
        dest ind byte char char$$
        ind 1 +
    end drop
end

func strlen string : int64 in
    let str

    0 while dup str swap char?? 0 != do
        1 +
    end
end

func strcpy ptr@char ptr@char : in
    let dest src
    dest src src strlen 1 + memcpy ; also copy null terminator
end

func strrev ptr@char : in 
    let str
    0 let start
    str strlen 1 - let _end

    while start _end < do 
        str start char?? let temp
        str start str _end char?? char$$
        str _end temp char$$
        _end 1 - let _end
        start 1 + let start
    end
end

func stoi string : int64 in
    let s
    1 0 0 let sign res i

    while s i char?? ' ' = do
        i 1 + let i
    end

    if s i char?? dup '-' = swap '+' = || then
        if s i char?? '-' = then 
            -1 let sign
        end
        i 1 + let i
    end

    while s i char?? dup '0' >= swap '9' <= && do
        s i char?? '0' - int64
        10 res * + let res
        i 1 + let i
    end

    res sign *
end

func itos int64 ptr@char int64 : in 
    let num buf base
    0 let i
    false let is_negative

    if num 0 = then
        buf 0 '0'  char$$
        buf 1 '\0' char$$
    else 
        if num 0 < base 10 = && then
            true let is_negative
            num negi64 let num
        end

        while num 0 != do
            num base % let rem 
            if rem 9 > then
                buf i rem 10 - 'a' + char$$
            else
                buf i rem '0' + char$$
            end

            num base / let num
            i 1 + let i
        end

        if is_negative then
            buf i '-' char$$
            i 1 + let i
        end

        buf i '\0' char$$
        buf strrev
    end
end

func itos10 int64 ptr@char : in
    10 itos
end
