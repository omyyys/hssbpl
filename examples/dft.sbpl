include "complex.sbpl"
include "random.sbpl"

func dft ptr@ptr@any ptr@ptr@any int64 : in
    let inp out size

    0.0 0.0 complex let sum
    0.0 0.0 complex let w

    0 let i
    while i size < do
        0.0 0.0 sum complex_into

        0 let j
        while j size < do
            _2_PI negf64 i float64 * j float64 * size float64 / let angle
            0.0 angle w complex_into
            w w cexp

            inp j complex?? let inp_j 
            inp_j w w c*

            sum w sum c+ 

            j 1 + let j
        end

        out i sum complex$$
 
        i 1 + let i
    end

    sum free w free
end

func inverse_dft ptr@ptr@any ptr@ptr@any int64 : in
    let out inp size
     
    0.0 0.0 complex let sum
    0.0 0.0 complex let w

    0 let j
    while j size < do
        0.0 0.0 sum complex_into

        0 let i
        while i size < do
            _2_PI j float64 * i float64 * size float64 / let angle
            0.0 angle w complex_into
            w w cexp

            out i complex?? let out_i
            out_i w w c* 
   
            sum w sum c+

            i 1 + let i
        end
 
        sum 1.0 size float64 / sum c*s
        inp j sum complex$$
 
        j 1 + let j
    end

    sum free w free
end

func print_complex_list ptr@ptr@any int64 : in
    let x size 

    0 let i
    while i size < do
        i printi64 ": " prints
        x i complex?? putcomplex 

        i 1 + let i
    end
end

define N 16

N sizeof(Complex) calloc ptr@ptr@any let x
N sizeof(Complex) calloc ptr@ptr@any let X
N sizeof(Complex) calloc ptr@ptr@any let xr

10 srand ; deterministic but still random input

0.0 0.0 complex let c

; populate with random entries [0, 1]
0 let i
while i N < do
    random random c complex_into
    x i c complex$$
    i 1 + let i
end

c free

"x : " puts
x N print_complex_list

x X N dft

'\n' putchar
"dft(x) : " puts
X N print_complex_list

X xr N inverse_dft

'\n' putchar
"inv_dft(dft(x)) : " puts
xr N print_complex_list
