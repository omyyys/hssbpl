include "stdio.sbpl"
include "malloc.sbpl"
include "random.sbpl"

define WIDTH 140
define HEIGHT 35

define DELAY_MS 100.0
define INIT_PAUSE_S 2.0

define INIT_ALIVE_ODDS 5

define CLEAR_SCREEN "\x1b[2J" puts
define RESET_CURSOR "\x1b[H" puts
define HIDE_CURSOR "\x1b[?25l" puts
define UNHIDE_CURSOR "\x1b[?25h" puts

; x y idx
func idx int64 int64 : int64 in WIDTH * + end

func make_alive ptr@int64 int64 int64 : in idx 1 int64$$ end

func count_neighbours ptr@int64 int64 int64 : int64 in
    let game x y 

    0 let n

    -1 let dy
    while dy 1 <= do
        y dy + HEIGHT + HEIGHT % let yy

        -1 let dx
        while dx 1 <= do
            if dx 0 = dy 0 = && then
                dx 1 + let dx ; continue
            else
                x dx + WIDTH + WIDTH % let xx
                game xx yy idx int64?? 0 != n + let n
                dx 1 + let dx 
            end
        end
        
        dy 1 + let dy
    end

    n
end

func step ptr@int64 ptr@int64 : in
    let cur next

    0 let y
    while y HEIGHT < do
        0 let x
        while x WIDTH < do
            cur x y idx int64?? 0 != let is_alive
            cur x y count_neighbours let n
            next x y idx 
            n 2 = n 3 = || is_alive && is_alive ! n 3 = && ||
            int64$$

            x 1 + let x
        end

        y 1 + let y
    end
end

func draw ptr@int64 : in
    let game

    RESET_CURSOR

    0 let y
    while y HEIGHT < do
        0 let x
        while x WIDTH < do
            if game x y idx int64?? then '*' putchar else ' ' putchar end
            x 1 + let x
        end

        '\n' putchar
        y 1 + let y
    end
end

func apply_glider ptr@int64 : in
    let game

    game 20 5 make_alive game 22 5 make_alive
    game 21 6 make_alive game 22 6 make_alive
    game 21 7 make_alive
end

func apply_glider_gun ptr@int64 : in
    let game

    game 30 15 make_alive game 31 15 make_alive game 30 16 make_alive game 31 16 make_alive

    game 40 15 make_alive game 40 16 make_alive game 40 17 make_alive
    game 41 14 make_alive game 41 18 make_alive
    game 42 13 make_alive game 42 19 make_alive
    game 43 13 make_alive game 43 19 make_alive

    game 44 16 make_alive
    game 45 14 make_alive game 45 18 make_alive
    game 46 15 make_alive game 46 16 make_alive game 46 17 make_alive
    game 47 16 make_alive

    game 50 13 make_alive game 51 13 make_alive game 50 14 make_alive game 51 14 make_alive game 50 15 make_alive game 51 15 make_alive 
    game 52 12 make_alive game 52 16 make_alive
    game 54 12 make_alive game 54 16 make_alive game 54 11 make_alive game 54 17 make_alive

    game 64 13 make_alive game 65 13 make_alive game 64 14 make_alive game 65 14 make_alive
end

func apply_random ptr@int64 int64 : in
    let game alive_odds

    0 let i
    while i WIDTH HEIGHT * < do
        game i rand alive_odds % 0 = int64$$
        i 1 + let i
    end
end

func all_dead? ptr@int64 : bool in
    let game

    0 let i
    while i WIDTH HEIGHT * < do
        if game i int64?? 0 != then false return end
        i 1 + let i
    end

    true
end

WIDTH HEIGHT * sizeof(int64) calloc ptr@int64 let a
WIDTH HEIGHT * sizeof(int64) calloc ptr@int64 let b

if a NULL = b NULL = || then 
    "gol.sbpl: error: failed to malloc space for game" eputs
    1 exit 
end

time srand

;a INIT_ALIVE_ODDS apply_random
a apply_glider_gun

CLEAR_SCREEN HIDE_CURSOR

a draw
INIT_PAUSE_S sleep

while a all_dead? ! do 
    a draw
    a b step

    a let tmp
    b let a
    tmp let b

    DELAY_MS 1000.0 / sleep
end

UNHIDE_CURSOR
